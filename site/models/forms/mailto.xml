<?xml version="1.0" encoding="UTF-8"?>
<form>
    <fieldset name="details">
        <field
                name="emailto"
                type="email"
                label="COM_JEM_MAILTO_EMAIL_TO"
                filter="string"
                required="true"
                size="30"
                maxlength="254"
                validate="email"
                autocomplete="email"
        />

        <field
                name="sender"
                type="text"
                label="COM_JEM_MAILTO_SENDER"
                filter="string"
                required="true"
                size="30"
                maxlength="128"
                readonly="true"
        />

        <field
                name="emailfrom"
                type="email"
                label="COM_JEM_MAILTO_YOUR_EMAIL"
                filter="string"
                required="true"
                size="30"
                maxlength="254"
                readonly="true"
                validate="email"
                autocomplete="email"
        />

        <field
                name="subject"
                type="text"
                label="COM_JEM_MAILTO_SUBJECT"
                filter="string"
                required="true"
                size="30"
                maxlength="255"
        />

        <field
                name="captcha"
                type="captcha"
                label="COM_JEM_MAILTO_CAPTCHA"
                validate="captcha"
        />
    </fieldset>
</form>
