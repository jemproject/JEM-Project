<?xml version="1.0" encoding="UTF-8"?>
<form>
    <fieldset name="content">
        <field name="section" type="hidden" filter="cmd" />
        <field name="language" type="hidden" filter="cmd" />
        <field
            name="body"
            type="textarea"
            label="COM_JEM_NOTIFICATION_CONTENT_PLAIN"
            rows="12"
            filter="raw"
        />
        <field
            name="htmlbody"
            type="editor"
            label="COM_JEM_NOTIFICATION_CONTENT_HTML"
            buttons="true"
            hide="fields,pagebreak,readmore,module"
            filter="raw"
        />
        <field
            name="privacy_url"
            type="url"
            label="COM_JEM_NOTIFICATION_CONTENT_PRIVACY_URL"
            description="COM_JEM_NOTIFICATION_CONTENT_PRIVACY_URL_DESC"
            filter="url"
        />
        <field
            name="enabled_user"
            type="radio"
            label="COM_JEM_NOTIFICATION_CONTENT_ENABLE_USER"
            layout="joomla.form.field.radio.switcher"
            default="0"
            filter="integer"
        >
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>
        <field
            name="enabled_admin"
            type="radio"
            label="COM_JEM_NOTIFICATION_CONTENT_ENABLE_ADMIN"
            layout="joomla.form.field.radio.switcher"
            default="0"
            filter="integer"
        >
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>
    </fieldset>
</form>
