<?xml version="1.0" encoding="UTF-8"?>
<form>
    <fields name="filter">
        <field
            name="search"
            type="text"
            inputmode="search"
            label="COM_JEM_SEARCH"
            hint="JSEARCH_FILTER"
        />

        <field
            name="search_type"
            type="list"
            label="COM_JEM_FILTER_SEARCH_IN"
            class="js-select-submit-on-change"
            validate="options"
        >
            <option value="0">JALL</option>
            <option value="1">COM_JEM_VENUE</option>
            <option value="2">COM_JEM_CITY</option>
            <option value="3">COM_JEM_STATE</option>
            <option value="4">COM_JEM_COUNTRY</option>
        </field>

        <field
            name="published"
            type="list"
            label="JSTATUS"
            class="js-select-submit-on-change"
            validate="options"
        >
            <option value="">JOPTION_SELECT_PUBLISHED</option>
            <option value="1">JPUBLISHED</option>
            <option value="0">JUNPUBLISHED</option>
            <option value="2">JARCHIVED</option>
            <option value="-2">JTRASHED</option>
        </field>

        <field
            name="venue_type_id"
            type="sql"
            label="COM_JEM_TYPE"
            query="SELECT id AS value, name AS text FROM #__jem_types WHERE entity = 3 AND published = 1 ORDER BY ordering ASC, name ASC"
            key_field="value"
            value_field="text"
            class="js-select-submit-on-change"
        >
            <option value="0">COM_JEM_TYPE_FILTER_VENUE</option>
        </field>

        <field
            name="access"
            type="accesslevel"
            label="JGRID_HEADING_ACCESS"
            class="js-select-submit-on-change"
        >
            <option value="0">JOPTION_SELECT_ACCESS</option>
        </field>
    </fields>

    <fields name="list">
        <field
            name="fullordering"
            type="list"
            label="JGLOBAL_SORT_BY"
            class="js-select-submit-on-change"
            default="a.venue ASC"
            validate="options"
        >
            <option value="a.ordering ASC">JGRID_HEADING_ORDERING_ASC</option>
            <option value="a.ordering DESC">JGRID_HEADING_ORDERING_DESC</option>
            <option value="a.venue ASC">COM_JEM_FILTER_VENUE_ASC</option>
            <option value="a.venue DESC">COM_JEM_FILTER_VENUE_DESC</option>
            <option value="a.alias ASC">COM_JEM_FILTER_ALIAS_ASC</option>
            <option value="a.alias DESC">COM_JEM_FILTER_ALIAS_DESC</option>
            <option value="a.city ASC">COM_JEM_FILTER_CITY_ASC</option>
            <option value="a.city DESC">COM_JEM_FILTER_CITY_DESC</option>
            <option value="a.state ASC">COM_JEM_FILTER_STATE_ASC</option>
            <option value="a.state DESC">COM_JEM_FILTER_STATE_DESC</option>
            <option value="a.country ASC">COM_JEM_FILTER_COUNTRY_ASC</option>
            <option value="a.country DESC">COM_JEM_FILTER_COUNTRY_DESC</option>
            <option value="a.access ASC">JGRID_HEADING_ACCESS_ASC</option>
            <option value="a.access DESC">JGRID_HEADING_ACCESS_DESC</option>
            <option value="u.name ASC">JAUTHOR_ASC</option>
            <option value="u.name DESC">JAUTHOR_DESC</option>
            <option value="a.created ASC">COM_JEM_FILTER_CREATED_ASC</option>
            <option value="a.created DESC">COM_JEM_FILTER_CREATED_DESC</option>
            <option value="a.id ASC">JGRID_HEADING_ID_ASC</option>
            <option value="a.id DESC">JGRID_HEADING_ID_DESC</option>
        </field>

        <field
            name="limit"
            type="limitbox"
            label="JGLOBAL_LIST_LIMIT"
            class="js-select-submit-on-change"
        />
    </fields>
</form>
