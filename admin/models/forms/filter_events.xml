<?xml version="1.0" encoding="UTF-8"?>
<form>
    <field
        name="filter_type"
        type="list"
        label="COM_JEM_FILTER_SEARCH_IN"
        filtermode="selector"
        class="js-select-submit-on-change"
        validate="options"
    >
        <option value="0">COM_JEM_FILTER_SEARCH_DEFAULT</option>
        <option value="1">COM_JEM_EVENT_TITLE</option>
        <option value="2">COM_JEM_VENUE</option>
        <option value="3">COM_JEM_CITY</option>
        <option value="4">COM_JEM_CATEGORY</option>
        <option value="5">COM_JEM_STATE</option>
        <option value="6">COM_JEM_COUNTRY</option>
        <option value="7">COM_JEM_AUTHOR</option>
        <option value="8">JALL</option>
    </field>

    <fields name="filter">
        <field
            name="search"
            type="text"
            inputmode="search"
            label="COM_JEM_SEARCH"
            hint="JSEARCH_FILTER"
        />

        <field
            name="begin"
            type="calendar"
            label="COM_JEM_EVENTS_FILTER_STARTDATE"
            hint="COM_JEM_EVENTS_FILTER_STARTDATE"
            format="%Y-%m-%d"
            showtime="false"
            todaybutton="true"
            filltable="false"
            class="js-select-submit-on-change"
        />

        <field
            name="end"
            type="calendar"
            label="COM_JEM_EVENTS_FILTER_ENDDATE"
            hint="COM_JEM_EVENTS_FILTER_ENDDATE"
            format="%Y-%m-%d"
            showtime="false"
            todaybutton="true"
            filltable="false"
            class="js-select-submit-on-change"
        />

        <field
            name="featured"
            type="list"
            label="JFEATURED"
            class="js-select-submit-on-change"
            validate="options"
        >
            <option value="">COM_JEM_FILTER_FEATURED</option>
            <option value="1">COM_JEM_FILTER_FEATURED_ONLY</option>
            <option value="0">COM_JEM_FILTER_UNFEATURED_ONLY</option>
        </field>

        <field
            name="published"
            type="list"
            label="JSTATUS"
            class="js-select-submit-on-change"
            validate="options"
        >
            <option value="">JOPTION_SELECT_PUBLISHED</option>
            <option value="1">JPUBLISHED</option>
            <option value="0">JUNPUBLISHED</option>
            <option value="2">JARCHIVED</option>
            <option value="-2">JTRASHED</option>
        </field>

        <field
            name="category_id"
            type="sql"
            label="COM_JEM_CATEGORY"
            query="SELECT id AS value, catname AS text FROM #__jem_categories WHERE published = 1 AND alias != 'root' ORDER BY lft ASC"
            key_field="value"
            value_field="text"
            class="js-select-submit-on-change"
        >
            <option value="0">COM_JEM_SELECT_CATEGORY</option>
        </field>

        <field
            name="venue_id"
            type="sql"
            label="COM_JEM_VENUE"
            query="SELECT id AS value, venue AS text FROM #__jem_venues WHERE published = 1 ORDER BY venue ASC"
            key_field="value"
            value_field="text"
            class="js-select-submit-on-change"
        >
            <option value="0">COM_JEM_SELECT_VENUE</option>
        </field>

        <field
            name="event_type_id"
            type="sql"
            label="COM_JEM_TYPE"
            query="SELECT id AS value, name AS text FROM #__jem_types WHERE entity = 1 AND published = 1 ORDER BY ordering ASC, name ASC"
            key_field="value"
            value_field="text"
            class="js-select-submit-on-change"
        >
            <option value="0">COM_JEM_TYPE_FILTER_EVENT</option>
        </field>

        <field
            name="access"
            type="accesslevel"
            label="JGRID_HEADING_ACCESS"
            class="js-select-submit-on-change"
        >
            <option value="0">JOPTION_SELECT_ACCESS</option>
        </field>
    </fields>

    <fields name="list">
        <field
            name="fullordering"
            type="list"
            label="JGLOBAL_SORT_BY"
            class="js-select-submit-on-change"
            default="a.dates ASC"
            validate="options"
        >
            <option value="a.dates ASC">COM_JEM_FILTER_DATE_ASC</option>
            <option value="a.dates DESC">COM_JEM_FILTER_DATE_DESC</option>
            <option value="a.times ASC">COM_JEM_FILTER_TIME_ASC</option>
            <option value="a.times DESC">COM_JEM_FILTER_TIME_DESC</option>
            <option value="a.title ASC">JGLOBAL_TITLE_ASC</option>
            <option value="a.title DESC">JGLOBAL_TITLE_DESC</option>
            <option value="a.featured ASC">JFEATURED_ASC</option>
            <option value="a.featured DESC">JFEATURED_DESC</option>
            <option value="a.event_status ASC">COM_JEM_FILTER_EVENT_STATUS_ASC</option>
            <option value="a.event_status DESC">COM_JEM_FILTER_EVENT_STATUS_DESC</option>
            <option value="a.ticket_availability ASC">COM_JEM_FILTER_TICKET_AVAILABILITY_ASC</option>
            <option value="a.ticket_availability DESC">COM_JEM_FILTER_TICKET_AVAILABILITY_DESC</option>
            <option value="jt.name ASC">COM_JEM_FILTER_TYPE_ASC</option>
            <option value="jt.name DESC">COM_JEM_FILTER_TYPE_DESC</option>
            <option value="loc.venue ASC">COM_JEM_FILTER_VENUE_ASC</option>
            <option value="loc.venue DESC">COM_JEM_FILTER_VENUE_DESC</option>
            <option value="a.article_id ASC">COM_JEM_FILTER_ARTICLE_ID_ASC</option>
            <option value="a.article_id DESC">COM_JEM_FILTER_ARTICLE_ID_DESC</option>
            <option value="a.access ASC">JGRID_HEADING_ACCESS_ASC</option>
            <option value="a.access DESC">JGRID_HEADING_ACCESS_DESC</option>
            <option value="u.name ASC">JAUTHOR_ASC</option>
            <option value="u.name DESC">JAUTHOR_DESC</option>
            <option value="a.hits ASC">JGLOBAL_HITS_ASC</option>
            <option value="a.hits DESC">JGLOBAL_HITS_DESC</option>
            <option value="a.last_visit ASC">COM_JEM_FILTER_LAST_VISIT_ASC</option>
            <option value="a.last_visit DESC">COM_JEM_FILTER_LAST_VISIT_DESC</option>
            <option value="a.created ASC">COM_JEM_FILTER_CREATED_ASC</option>
            <option value="a.created DESC">COM_JEM_FILTER_CREATED_DESC</option>
            <option value="a.id ASC">JGRID_HEADING_ID_ASC</option>
            <option value="a.id DESC">JGRID_HEADING_ID_DESC</option>
        </field>

        <field
            name="limit"
            type="limitbox"
            label="JGLOBAL_LIST_LIMIT"
            class="js-select-submit-on-change"
        />
    </fields>
</form>
